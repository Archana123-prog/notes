# Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection String
# Get this from your Neon Console (https://console.neon.tech)
# Example: postgresql://neondb_owner:npg_xxxxxx@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-your-project-id.region.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_notes_app_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Connection (CORS)
# URL of your React frontend (Vite default is http://localhost:5173, CRA is http://localhost:3000)
CLIENT_URL=http://localhost:5173
